// YA7EDU Comprehensive Database Schema for Egyptian LMS Platform
// Configured for MySQL 8.0 on VPS (107.173.52.132)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. Academic Structure (Thanawya Amma Egyptian Hierarchy)
// ----------------------------------------------------

model AcademicGrade {
  id                  String               @id // e.g. "grade-1-sec", "grade-2-sec", "grade-3-sec"
  nameEn              String
  nameAr              String
  stage               String               @default("SECONDARY")
  description         String?              @db.Text
  createdAt           DateTime             @default(now())

  // Relationships
  subjects            Subject[]
  users               User[]
  instructorContents  InstructorContent[]
  exams               InstructorExam[]
  vouchers            VoucherCode[]
  subscriptions       TeacherSubscription[]
}

model Subject {
  id                  String               @id // e.g. "subj-physics-g3", "subj-chem-g3"
  nameEn              String
  nameAr              String
  gradeId             String
  grade               AcademicGrade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  icon                String               @default("BookOpen")
  color               String               @default("blue")
  description         String?              @db.Text
  createdAt           DateTime             @default(now())

  // Relationships
  instructorContents  InstructorContent[]
  exams               InstructorExam[]
  vouchers            VoucherCode[]
  subscriptions       TeacherSubscription[]

  @@index([gradeId])
}

// ----------------------------------------------------
// 2. Users & Authentication
// ----------------------------------------------------

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String
  phone                 String?
  passwordHash          String?
  role                  String                 @default("STUDENT") // "ADMIN" | "INSTRUCTOR" | "STUDENT"
  status                String                 @default("ACTIVE")  // "ACTIVE" | "SUSPENDED" | "PENDING_APPROVAL"
  avatar                String?                @db.Text
  headline              String?
  bio                   String?                @db.Text
  gradeId               String?
  grade                 AcademicGrade?         @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  validityType          String                 @default("LIFETIME") // "LIFETIME" | "TIME_LIMITED"
  validityDurationLabel String?
  validityExpiresAt     DateTime?
  joinedAt              DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relationships
  profile               Profile?
  authoredCourses       Course[]               @relation("InstructorCourses")
  authoredContents      InstructorContent[]    @relation("InstructorContents")
  authoredExams         InstructorExam[]       @relation("InstructorAuthoredExams")
  studentExamAttempts   StudentExamAttempt[]   @relation("StudentExamAttempts")
  studentSubscriptions  TeacherSubscription[]  @relation("StudentSubscriptions")
  instructorSubscribers TeacherSubscription[]  @relation("InstructorSubscribers")
  redeemedVouchers      VoucherCode[]          @relation("RedeemedVouchers")
  generatedVouchers     VoucherCode[]          @relation("InstructorGeneratedVouchers")
  enrollments           Enrollment[]
  progress              Progress[]
  quizSubmissions       QuizSubmission[]
  reviews               Review[]
  transactions          Transaction[]
  payouts               Payout[]
  auditLogs             AuditLog[]

  @@index([role])
  @@index([status])
  @@index([gradeId])
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website              String?
  twitter              String?
  github               String?
  linkedin             String?
  payoutMethod         String?  // e.g. "VODAFONE_CASH", "INSTAPAY", "BANK_TRANSFER"
  payoutAccount        String?
  notificationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// ----------------------------------------------------
// 3. Teacher Subscriptions & Center Vouchers (كروت الشحن والاشتراكات)
// ----------------------------------------------------

model VoucherCode {
  code                  String               @id // e.g. "YA7-PHY-9821-X9"
  instructorId          String
  instructor            User                 @relation("InstructorGeneratedVouchers", fields: [instructorId], references: [id], onDelete: Cascade)
  instructorName        String
  subjectId             String
  subject               Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectName           String
  gradeId               String
  grade                 AcademicGrade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  duration              String               @default("1_MONTH") // "1_MONTH" | "3_MONTHS" | "FULL_TERM" | "FULL_YEAR"
  durationLabelEn       String
  durationLabelAr       String
  priceLabel            String               @default("150 ج.م")
  batchId               String?
  status                String               @default("AVAILABLE") // "AVAILABLE" | "REDEEMED" | "EXPIRED"
  redeemedByUserId      String?
  redeemedByUser        User?                @relation("RedeemedVouchers", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedByStudentName String?
  redeemedAt            DateTime?
  expiresAt             DateTime
  createdAt             DateTime             @default(now())

  @@index([instructorId])
  @@index([subjectId])
  @@index([gradeId])
  @@index([status])
  @@index([batchId])
}

model TeacherSubscription {
  id              String         @id @default(uuid())
  studentId       String
  student         User           @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)
  instructorId    String
  instructor      User           @relation("InstructorSubscribers", fields: [instructorId], references: [id], onDelete: Cascade)
  instructorName  String
  instructorAvatar String?       @db.Text
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectName     String
  gradeId         String
  grade           AcademicGrade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  activatedAt     DateTime       @default(now())
  expiresAt       DateTime
  durationLabel   String
  paymentMethod   String         @default("VOUCHER_CARD") // "VOUCHER_CARD" | "CREDIT_CARD" | "DIGITAL_WALLET"
  voucherCodeUsed String?
  status          String         @default("ACTIVE") // "ACTIVE" | "EXPIRED"

  @@index([studentId])
  @@index([instructorId])
  @@index([subjectId])
  @@index([gradeId])
  @@index([status])
}

// ----------------------------------------------------
// 4. Instructor Content: Chapters, Video Lessons & Booklets
// ----------------------------------------------------

model InstructorContent {
  id               String         @id // e.g. "content-ahmed-samy-phy-g3"
  instructorId     String
  instructor       User           @relation("InstructorContents", fields: [instructorId], references: [id], onDelete: Cascade)
  instructorName   String
  instructorTitle  String
  instructorAvatar String         @db.Text
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectName      String
  gradeId          String
  grade            AcademicGrade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  term             String         @default("Full Year")
  priceMonthly     Float          @default(150.0)
  priceTerm        Float          @default(400.0)
  priceYear        Float          @default(900.0)
  rating           Float          @default(4.9)
  totalSubscribers Int            @default(0)
  bioAr            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relationships
  chapters         Chapter[]
  booklets         BookletItem[]

  @@index([instructorId])
  @@index([subjectId])
  @@index([gradeId])
}

model Chapter {
  id            String             @id // e.g. "chap-phy-1"
  contentId     String
  content       InstructorContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  chapterNumber Int                @default(1)
  titleEn       String
  titleAr       String
  description   String?            @db.Text
  lessons       LessonVideo[]

  @@index([contentId])
}

model LessonVideo {
  id              String   @id // e.g. "les-phy-1-1"
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  titleEn         String
  titleAr         String
  durationMinutes Int      @default(45)
  videoUrl        String   @db.Text
  order           Int      @default(1)
  isFree          Boolean  @default(false) // Free preview for unauthenticated / unsubscribed students
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([chapterId])
}

model BookletItem {
  id              String            @id // e.g. "bk-phy-g3-ch1"
  contentId       String
  content         InstructorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  titleEn         String
  titleAr         String
  chapterTitle    String?
  pageCount       Int?              @default(24)
  fileSize        String?           @default("14.2 MB")
  downloadUrl     String?           @db.Text
  type            String            @default("BOOKLET") // "BOOKLET" | "REVISION" | "YA7EDU_EXCLUSIVE"
  uploadDate      String
  isExclusive     Boolean           @default(false)
  isFree          Boolean           @default(false)
  format          String            @default("PDF") // "PDF" | "INTERACTIVE_PRACTICE" | "VIDEO"
  videoUrl        String?           @db.Text
  durationMinutes Int?
  createdAt       DateTime          @default(now())

  // Relationships
  questions       BookletQuestion[]

  @@index([contentId])
  @@index([type])
}

model BookletQuestion {
  id            String      @id
  bookletId     String
  booklet       BookletItem @relation(fields: [bookletId], references: [id], onDelete: Cascade)
  questionAr    String      @db.Text
  options       String      @db.Text // JSON array of options
  correctIndex  Int         @default(0)
  explanationAr String      @db.Text

  @@index([bookletId])
}

// ----------------------------------------------------
// 5. Center Exams & Embargo System (الامتحانات وحجب النتائج)
// ----------------------------------------------------

model InstructorExam {
  id                          String                  @id // e.g. "exam-phy-ch1-2026"
  instructorId                String
  instructor                  User                    @relation("InstructorAuthoredExams", fields: [instructorId], references: [id], onDelete: Cascade)
  instructorName              String
  instructorAvatar            String?                 @db.Text
  subjectId                   String
  subject                     Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectName                 String
  gradeId                     String
  grade                       AcademicGrade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  title                       String
  description                 String                  @db.Text
  durationMinutes             Int                     @default(60)
  startDate                   String?
  startTime                   String?
  endDate                     String?
  endTime                     String?
  passingPercent              Int                     @default(60)
  totalMarks                  Int                     @default(50)
  isPublished                 Boolean                 @default(true)
  hideResultUntilDurationEnds Boolean                 @default(true) // Embargo mode
  createdAt                   DateTime                @default(now())

  // Relationships
  questions                   InstructorExamQuestion[]
  attempts                    StudentExamAttempt[]

  @@index([instructorId])
  @@index([subjectId])
  @@index([gradeId])
}

model InstructorExamQuestion {
  id                 String         @id
  examId             String
  exam               InstructorExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText       String         @db.Text
  options            String         @db.Text // JSON array of options
  correctOptionIndex Int            @default(0)
  explanation        String         @db.Text
  marks              Int            @default(2)

  @@index([examId])
}

model StudentExamAttempt {
  id          String         @id @default(uuid())
  examId      String
  exam        InstructorExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  answers     String         @db.Text // JSON mapping questionId -> chosen index
  scorePercent Float         @default(0.0)
  totalScore  Float          @default(0.0)
  maxScore    Float          @default(50.0)
  passed      Boolean        @default(false)
  isUnlocked  Boolean        @default(false) // Unlocked when embargo passes or instructor releases

  @@index([examId])
  @@index([studentId])
}

// ----------------------------------------------------
// 6. Extended Course Marketplace Models (Legacy & Future Expandability)
// ----------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  courses     Course[]
}

model Course {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  subtitle        String?
  description     String        @db.Text
  thumbnail       String?       @db.Text
  previewVideoUrl String?       @db.Text
  price           Float         @default(0.0)
  discountPrice   Float?
  level           String        @default("ALL_LEVELS")
  status          String        @default("DRAFT")
  rejectionReason String?       @db.Text
  publishedAt     DateTime?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructorId    String
  instructor      User          @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections        Section[]
  enrollments     Enrollment[]
  reviews         Review[]
  transactions    Transaction[]

  @@index([instructorId])
  @@index([status])
  @@index([categoryId])
}

model Section {
  id          String   @id @default(uuid())
  title       String
  orderIndex  Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model Lesson {
  id               String     @id @default(uuid())
  title            String
  slug             String?
  description      String?    @db.Text
  videoUrl         String?    @db.Text
  durationSeconds  Int        @default(0)
  orderIndex       Int        @default(0)
  isPreview        Boolean    @default(false)
  resources        String?    @db.Text
  articleContent   String?    @db.Text
  sectionId        String
  section          Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quiz             Quiz?
  progressRecords  Progress[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([sectionId])
}

model Quiz {
  id                String           @id @default(uuid())
  lessonId          String           @unique
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title             String
  description       String?          @db.Text
  passingScore      Int              @default(75)
  timeLimitMinutes  Int              @default(15)
  questions         String           @db.Text // JSON serialized
  submissions       QuizSubmission[]
  createdAt         DateTime         @default(now())
}

model QuizSubmission {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float
  passed      Boolean
  answers     String   @db.Text
  feedback    String?  @db.Text
  completedAt DateTime @default(now())

  @@index([quizId])
  @@index([userId])
}

model Enrollment {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Float     @default(0.0)
  completedAt     DateTime?
  certificateId   String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Progress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted       Boolean  @default(false)
  lastWatchedSecond Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Review {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating          Int       @default(5)
  comment         String    @db.Text
  instructorReply String?   @db.Text
  replyCreatedAt  DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model Transaction {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  amount            Float
  platformFee       Float
  instructorEarning Float
  status            String   @default("COMPLETED")
  paymentIntentId   String?
  receiptUrl        String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([courseId])
}

model Payout {
  id             String    @id @default(uuid())
  instructorId   String
  instructor     User      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  amount         Float
  status         String    @default("PENDING")
  payoutMethod   String    @default("INSTAPAY")
  accountDetails String?   @db.Text
  notes          String?   @db.Text
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?

  @@index([instructorId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model SystemConfig {
  id                     String   @id @default("default")
  platformCommissionRate Float    @default(15.0)
  payoutMinimumThreshold Float    @default(50.0)
  bannerAnnouncement     String?  @default("🚀 مرحباً بكم في منصة YA7EDU الرقمية الذكية - العام الدراسي 2026")
  isMaintenanceMode      Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}
